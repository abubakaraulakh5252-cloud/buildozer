# college_fee_app.py
from flask import Flask, request, redirect, url_for, render_template_string, flash, session
from datetime import datetime
import bcrypt
from sqlalchemy import create_engine, Column, Integer, String, DateTime, Boolean, ForeignKey
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy.orm import sessionmaker, relationship
import os

# ---------- CONFIG ----------
APP_NAME = "AL-Amen College"
DB_FILE = "sqlite:///college_local.db"
SECRET_KEY = os.urandom(24)

# Fee structure per class (you can change amounts)
FEE_STRUCTURE = {
    "9": 2000,
    "10": 2200,
    "11": 2500,
    "12": 2800
}

MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]

# ---------- DB SETUP ----------
engine = create_engine(DB_FILE, connect_args={"check_same_thread": False})
Base = declarative_base()
SessionLocal = sessionmaker(bind=engine)
db = SessionLocal()

class User(Base):
    __tablename__ = "users"
    id = Column(Integer, primary_key=True, autoincrement=True)
    name = Column(String)
    email = Column(String, unique=True)
    phone = Column(String)
    clazz = Column(String)  # class 9..12
    roll_no = Column(String)
    password_hash = Column(String)
    created_at = Column(DateTime, default=datetime.utcnow)
    # relationships
    fees = relationship("FeeStatus", back_populates="user")

class FeeStatus(Base):
    __tablename__ = "fees"
    id = Column(Integer, primary_key=True, autoincrement=True)
    user_id = Column(Integer, ForeignKey("users.id"))
    month = Column(String)      # e.g., "Jan"
    year = Column(Integer)
    paid = Column(Boolean, default=False)
    paid_at = Column(DateTime, nullable=True)
    user = relationship("User", back_populates="fees")

Base.metadata.create_all(engine)

# ---------- FLASK APP ----------
app = Flask(__name__)
app.secret_key = SECRET_KEY

# ---------- HELPERS ----------
def hash_password(plain):
    return bcrypt.hashpw(plain.encode(), bcrypt.gensalt()).decode()

def check_password(plain, hashed):
    try:
        return bcrypt.checkpw(plain.encode(), hashed.encode())
    except:
        return False

def init_fee_records_for_user(user):
    """جب یوزر پہلی بار بنے تو اس کے لئے سال بھر کے مہینے داخل کریں (paid=False)"""
    # use current year
    y = datetime.utcnow().year
    for m in MONTHS:
        f = FeeStatus(user_id=user.id, month=m, year=y, paid=False)
        db.add(f)
    db.commit()

def send_sms_simulated(phone, message):
    """SMS بھیجنے کی simulation — یہاں آپ SMS gateway لگائیں گے"""
    # placeholder: print to console (simulation)
    print(f"[SIMULATED SMS] to {phone}: {message}")
    # If you have a gateway (Twilio etc), integrate here and return True/False
    return True

