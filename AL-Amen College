# ---------- ROUTES ----------
@app.route("/")
def index():
    return render_template_string(INDEX_HTML, app_name=APP_NAME)

@app.route("/register", methods=["POST"])
def register():
    name = request.form.get("name").strip()
    email = request.form.get("email").strip().lower()
    phone = request.form.get("phone").strip()
    clazz = request.form.get("clazz")
    roll_no = request.form.get("roll_no").strip()
    password = request.form.get("password")

    if not (name and email and phone and clazz and roll_no and password):
        flash("تمام فیلڈز لازمی ہیں")
        return redirect(url_for("index"))

    # existing?
    if db.query(User).filter_by(email=email).first():
        flash("یہ ای میل پہلے سے رجسٹرڈ ہے")
        return redirect(url_for("index"))

    hashed = hash_password(password)
    u = User(name=name, email=email, phone=phone, clazz=clazz, roll_no=roll_no, password_hash=hashed)
    db.add(u)
    db.commit()

    # create fee records
    init_fee_records_for_user(u)

    flash("رجسٹریشن کامیاب۔ اب لاگ ان کریں")
    return redirect(url_for("index"))

@app.route("/login", methods=["POST"])
def login():
    email = request.form.get("email", "").strip().lower()
    password = request.form.get("password", "")
    u = db.query(User).filter_by(email=email).first()
    if not u or not check_password(password, u.password_hash):
        flash("غلط ای میل یا پاس ورڈ")
        return redirect(url_for("index"))

    # set session
    session['user_id'] = u.id

    # On login: send message (simulated) to user's mobile
    msg = f"آپ نے {APP_NAME} میں لاگ ان کیا ہے۔ تاریخ: {datetime.utcnow().strftime('%Y-%m-%d %H:%M:%S')}"
    sms_ok = send_sms_simulated(u.phone, msg)
    if sms_ok:
        flash("Login successful — SMS sent (simulated).")
    else:
        flash("Login successful — SMS sending failed (check gateway).")
    return redirect(url_for("dashboard"))

@app.route("/dashboard")
def dashboard():
    uid = session.get('user_id')
    if not uid:
        flash("براہ کرم پہلے لاگ ان کریں")
        return redirect(url_for("index"))
    u = db.query(User).filter_by(id=uid).first()
    if not u:
        flash("یوزر نہیں ملا")
        return redirect(url_for("index"))

    # fetch fee records for current year
    year = datetime.utcnow().year
    fees = db.query(FeeStatus).filter_by(user_id=u.id, year=year).all()
    # get fee amount from structure
    fee_amount = FEE_STRUCTURE.get(u.clazz, 0)
    # format paid_at
    fee_view = []
    for f in fees:
        paid_at = f.paid_at.strftime("%Y-%m-%d %H:%M:%S") if f.paid_at else ""
        fee_view.append({
            "id": f.id, "month": f.month, "paid": f.paid, "paid_at": paid_at
        })
    return render_template_string(DASH_HTML, app_name=APP_NAME, user=u, fees=fee_view, fee_amount=fee_amount, year=year)

@app.route("/pay/<int:fee_id>", methods=["POST"])
def pay(fee_id):
    uid = session.get('user_id')
    if not uid:
        flash("پہلے لاگ ان کریں")
        return redirect(url_for("index"))
    fee = db.query(FeeStatus).filter_by(id=fee_id, user_id=uid).first()
    if not fee:
        flash("فیس کا ریکارڈ نہیں ملا")
        return redirect(url_for("dashboard"))
    if fee.paid:
        flash("یہ مہینہ پہلے ہی ادا ہو چکا ہے")
        return redirect(url_for("dashboard"))
    # Here: integrate payment gateway. For demo, we mark paid directly.
    fee.paid = True
    fee.paid_at = datetime.utcnow()
    db.commit()
    flash(f"{fee.month} کی فیس ادا ہو گئی")
    return redirect(url_for("dashboard"))

# simple admin view to list users (no auth for simplicity; in production secure this)
@app.route("/admin")
def admin():
    users = db.query(User).all()
    return render_template_string(ADMIN_HTML, app_name=APP_NAME, users=users)

@app.route("/logout")
def logout():
    session.pop('user_id', None)
    flash("لاگ آؤٹ ہو گئے")
    return redirect(url_for("index"))

